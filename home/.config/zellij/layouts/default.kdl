layout {
    default_tab_template {
        // Minimal single-line compact-bar (tabs + mode indicator). Keybinding
        // hints are provided on demand by the zj-which-key plugin (floating
        // popup on mode-entry; Ctrl+y to force it) — see config.kdl load_plugins.
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
        children
    }

    tab
}
