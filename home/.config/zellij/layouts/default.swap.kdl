// TILED
//
// First layout listed is the one a new session starts in; Ctrl F11/F12 cycle.

// Two top-level COLUMNS, each a 70/30 top-over-bottom. Zellij fills
// top-level sections in creation order, alternating between them, so panes
// 1 and 2 take the two tops and everything after alternates between the two
// bottoms - the top pair never gets displaced.
//
// Enumerated per pane count on purpose: two `children` growth points do NOT
// alternate (the first absorbs nearly all panes, leaving one lonely wide pane
// on the right), so the counts are spelled out instead.
swap_tiled_layout name="2-top" {
    tab max_panes=3 {
        pane split_direction="vertical" {
            pane
            pane
        }
    }
    tab max_panes=4 {
        pane split_direction="vertical" {
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%"
            }
            pane size="50%"
        }
    }
    tab max_panes=5 {
        pane split_direction="vertical" {
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%"
            }
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%"
            }
        }
    }
    tab max_panes=6 {
        pane split_direction="vertical" {
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                }
            }
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%"
            }
        }
    }
    tab max_panes=7 {
        pane split_direction="vertical" {
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                }
            }
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                }
            }
        }
    }
    tab max_panes=8 {
        pane split_direction="vertical" {
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                    pane
                }
            }
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                }
            }
        }
    }
    tab max_panes=9 {
        pane split_direction="vertical" {
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                    pane
                }
            }
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                    pane
                }
            }
        }
    }
    tab max_panes=10 {
        pane split_direction="vertical" {
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                    pane
                    pane
                }
            }
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                    pane
                }
            }
        }
    }
    tab max_panes=11 {
        pane split_direction="vertical" {
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                    pane
                    pane
                }
            }
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
    }
    tab max_panes=12 {
        pane split_direction="vertical" {
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                    pane
                    pane
                    pane
                }
            }
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
    }
    tab max_panes=13 {
        pane split_direction="vertical" {
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                    pane
                    pane
                    pane
                }
            }
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
    }
    tab {
        pane split_direction="vertical" {
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    children
                }
            }
            pane size="50%" split_direction="horizontal" {
                pane size="70%"
                pane size="30%" split_direction="vertical" {
                    pane
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
    }
}
swap_tiled_layout name="1-left" {
    tab max_panes=7 {
        pane split_direction="vertical" {
            pane size="70%"
            pane size="30%" split_direction="horizontal" {
                pane
                pane
                pane
                pane
            }
        }
    }
    tab split_direction="vertical" max_panes=9 {
        pane size="50%"
        pane split_direction="horizontal" size="25%" {
            pane
            pane
            pane
        }
        pane split_direction="horizontal" size="25%" {
            pane
            pane
            pane
        }
    }
    tab split_direction="vertical" max_panes=11 {
        pane size="50%"
        pane split_direction="horizontal" size="25%" {
            pane
            pane
            pane
            pane
        }
        pane split_direction="horizontal" size="25%" {
            pane
            pane
            pane
            pane
        }
    }
    tab split_direction="vertical" max_panes=17 {
        pane size="50%"
        pane split_direction="horizontal" size="25%" {
            pane
            pane
            pane
            pane
        }
        pane size="25%" {
            pane split_direction="horizontal" stacked=true size="50%" {
                pane
                pane
                pane
                pane
                pane
            }
            pane split_direction="horizontal" stacked=true size="50%" {
                pane
                pane
                pane
                pane
                pane
            }
        }
    }
}
swap_tiled_layout name="stack" {
    tab {
        pane stacked=true {
            pane
        }
    }
}

// FLOATING: no swap_floating_layout defined — Zellij uses its built-in
// centered placement for floating panes. (Removed ~730 lines of hand-enumerated
// float-large/float-small presets that went unused.)
